<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OpenCart_TestNG_POM_Suite" parallel="classes" thread-count="2">

    <groups>
        <run>
            <include name="Master"/>
        </run>
    </groups>
    
    <listeners>
        <listener class-name="utilities.ExtentReportManager"/>
    </listeners>

    <test name="OpenCart_Functional_Tests">
        <parameter name="os" value="windows"/>
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testCases.TC_001_AccountRegistrationTest"/>
            <class name="testCases.TC_002_LoginTest"/>
            <class name="testCases.TC_003_LoginDDT"/>
            <class name="testCases.TC_004_SearchTest"/>
            <class name="testCases.TC_005_AddToCartTest"/>
            <class name="testCases.TC_006_EndToEndTest"/>
        </classes>
    </test>

</suite>